{
  "name": "hold-the-deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sim": "node --import ./scripts/sim/register.mjs scripts/sim/simulate.mjs",
    "sim:frost": "node --import ./scripts/sim/register.mjs scripts/sim/frost.mjs",
    "sim:fog": "node --import ./scripts/sim/register.mjs scripts/sim/fog.mjs",
    "sim:parts": "node --import ./scripts/sim/register.mjs scripts/sim/parts.mjs",
    "sim:abyss": "node --import ./scripts/sim/register.mjs scripts/sim/abyss.mjs",
    "sim:packs": "node --import ./scripts/sim/register.mjs scripts/sim/packs.mjs",
    "sim:stars": "node --import ./scripts/sim/register.mjs scripts/sim/stars.mjs",
    "sim:uncharted": "node --import ./scripts/sim/register.mjs scripts/sim/uncharted.mjs",
    "sim:awaken-pace": "node --import ./scripts/sim/register.mjs scripts/sim/awaken_pace.mjs",
    "test": "node --import ./scripts/sim/register.mjs scripts/tests/tutorial.mjs && node --import ./scripts/sim/register.mjs scripts/tests/audio.mjs && node --import ./scripts/sim/register.mjs scripts/tests/mobile.mjs && node --import ./scripts/sim/register.mjs scripts/tests/rankings.mjs && node --import ./scripts/sim/register.mjs scripts/tests/uncharted.mjs",
    "app:sync": "npm run build && npx cap sync android",
    "app:apk": "node scripts/app-apk.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/splash-screen": "^7.0.5",
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "playwright-core": "^1.49.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
